/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are cached for a year without revalidation. Their filenames carry no
# content hash, so a changed font file must be published under a new filename
# (and the @font-face rules and preloads pointed at it); otherwise returning
# visitors keep the old file for up to a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
